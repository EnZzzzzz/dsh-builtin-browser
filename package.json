{
  "name": "dsh-builtin-browser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "desktop",
    "README.md",
    "vendor",
    "locale",
    "icon.svg",
    "docs"
  ],
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node vendor/selector/build.mjs && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "playground": "node playground/dev.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
